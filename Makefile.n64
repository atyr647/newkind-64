BUILD_DIR = build
SOURCE_DIR = .

include $(N64_INST)/include/n64.mk

# tiny3d (https://github.com/HailToDodongo/tiny3d), built with the same toolchain.
TINY3D_DIR ?= $(N64_INST)/tiny3d
include $(TINY3D_DIR)/t3d.mk

N64_ROM_TITLE = "Elite - The New Kind"
N64_ROM_SAVETYPE = eeprom16k
N64_ROM_REGIONFREE = true

SRCS = \
	n64_main.c \
	n64_gfx.c \
	n64_input.c \
	n64_sound.c \
	n64_file.c \
	n64_font.c \
	n64_spritedata.c \
	n64_ships3d.c \
	n64_shiptex.c \
	elite.c \
	docked.c \
	intro.c \
	missions.c \
	options.c \
	pilot.c \
	planet.c \
	random.c \
	shipdata.c \
	shipface.c \
	space.c \
	stars.c \
	swat.c \
	threed.c \
	trade.c \
	vector.c

OBJS = $(SRCS:%.c=$(BUILD_DIR)/%.o)

# Extra compiler flags, e.g. make -f Makefile.n64 EXTRA_CFLAGS=-DN64_SHOW_FPS
EXTRA_CFLAGS ?=
CFLAGS += -DPLATFORM_N64 -I. -Wno-error $(EXTRA_CFLAGS)

# Filesystem assets
WAV_SRCS = launch.wav crash.wav dock.wav gameover.wav pulse.wav hitem.wav \
           explode.wav ecm.wav missile.wav hyper.wav incom1.wav incom2.wav \
           beep.wav boop.wav
WAV64_TARGETS = $(WAV_SRCS:%.wav=filesystem/%.wav64)

# Music: the original MIDI tunes pre-rendered to WAV (tools/render_music.sh)
MUSIC_SRCS = theme.wav danube.wav
MUSIC64_TARGETS = $(MUSIC_SRCS:%.wav=filesystem/%.wav64)

all: elite_newkind.z64

filesystem:
	@mkdir -p filesystem

filesystem/%.wav64: %.wav | filesystem
	@echo "    [AUDIO] $<"
	$(N64_AUDIOCONV) --wav-resample 22050 --wav-mono -o $@ $<

$(MUSIC64_TARGETS): filesystem/%.wav64: music/%.wav | filesystem
	@echo "    [MUSIC] $<"
	$(N64_AUDIOCONV) --wav-resample 22050 --wav-mono --wav-compress 1 -o $(dir $@) $<

filesystem/newkind.cfg: newkind.cfg | filesystem
	cp $< $@
filesystem/newscan.cfg: newscan.cfg | filesystem
	cp $< $@
filesystem/scanner.bmp: scanner.bmp | filesystem
	cp $< $@
filesystem/iconbar.bmp: iconbar.bmp | filesystem
	cp $< $@

# Ship textures (baked by tools/bake_ship_texture.py): 16-colour sprites.
SHIP_TEX_SRCS = $(wildcard ships/*.png)
SHIP_TEX_TARGETS = $(SHIP_TEX_SRCS:ships/%.png=filesystem/%.sprite)
filesystem/%.sprite: ships/%.png | filesystem
	@echo "    [SPRITE] $<"
	$(N64_MKSPRITE) --format CI4 -o filesystem $<

FILESYSTEM_DEPS = $(WAV64_TARGETS) $(MUSIC64_TARGETS) filesystem/newkind.cfg filesystem/newscan.cfg filesystem/scanner.bmp filesystem/iconbar.bmp $(SHIP_TEX_TARGETS)

$(BUILD_DIR)/elite_newkind.dfs: $(FILESYSTEM_DEPS)
elite_newkind.z64: $(BUILD_DIR)/elite_newkind.elf $(BUILD_DIR)/elite_newkind.dfs
$(BUILD_DIR)/elite_newkind.elf: $(OBJS)

clean:
	rm -rf $(BUILD_DIR) filesystem elite_newkind.z64

.PHONY: all clean
